# PUBLIC browser variables; these are safe to include in the client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# SERVER ONLY: Supabase PostgreSQL connection from Connect > Transaction pooler.
# Use URL-encoded password, and configure SSL. Never prefix DATABASE_URL with VITE_!
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR_PASSWORD@YOUR-POOLER-HOST:6543/postgres

# SERVER ONLY: Supabase Auth uses the same URL/publishable key to verify access tokens.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# SERVER ONLY: run openssl rand -base64 32; use different values for each secret.
APP_SESSION_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
DISCORD_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
LINK_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
AUTOMOD_HASH_PEPPER=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
INITIAL_ADMIN_EMAIL=your-confirmed-email@example.com
PUBLIC_APP_ORIGIN=https://your-project.vercel.app

# OPTIONAL: Third-party OAuth for linking Discord and Kick accounts.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_AUTOMOD_GUILD_ID=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_BROADCASTER_USER_ID=
# No always-on Discord gateway in Vercel Functions; set only in separate long-lived worker.
RUN_PERSISTENT_WORKERS=0
DISCORD_GATEWAY_ENABLED=0
