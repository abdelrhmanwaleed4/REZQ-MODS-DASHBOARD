{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__rezk_route=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
